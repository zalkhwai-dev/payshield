# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI agent: gemini (free tier) or anthropic. Leave empty for rules only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the default model (Gemini default: gemini-flash-latest)
AI_MODEL=

# Optional: Google Safe Browsing key (console.cloud.google.com -> enable "Safe Browsing API")
GOOGLE_SAFE_BROWSING_KEY=

PORT=5050

# Only for a public hosted demo (leave empty locally): limit checks per visitor per hour,
# and AI checks per day for everyone together. After the cap, the rule engine still works.
CHECKS_PER_HOUR=
AI_DAILY_CAP=
